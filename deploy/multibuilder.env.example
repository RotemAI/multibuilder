MULTIBUILDER_DATABASE_URL=postgresql+asyncpg:///multibuilder?host=/var/run/postgresql
MULTIBUILDER_ADMIN_TOKEN=replace-with-random-operator-token
MULTIBUILDER_COOKIE_SECRET=replace-with-separate-random-cookie-secret
MULTIBUILDER_PUBLIC_URL=https://multibuilder.grabo.tools
MULTIBUILDER_STATE_ROOT=/srv/multibuilder/state
MULTIBUILDER_BIND_HOST=127.0.0.1
MULTIBUILDER_PORT=8510
MULTIBUILDER_SCHEDULER_ENABLED=true
MULTIBUILDER_SCHEDULER_INTERVAL=1
MULTIBUILDER_GLOBAL_PARALLELISM=4
MULTIBUILDER_GIT_ALLOWED_HOSTS=github.com
GIT_AUTHOR_NAME=replace-with-operator-name
GIT_AUTHOR_EMAIL=replace-with-operator-email
GIT_COMMITTER_NAME=replace-with-operator-name
GIT_COMMITTER_EMAIL=replace-with-operator-email
MULTIBUILDER_CODEX_ENABLED=true
MULTIBUILDER_CODEX_BINARY=/usr/bin/codex
MULTIBUILDER_CODEX_REASONING=xhigh
MULTIBUILDER_CODEX_CONCURRENCY=2
MULTIBUILDER_MUSE_ENABLED=true
MULTIBUILDER_MUSE_BINARY=/home/nimrod_rotem/.local/bin/muse
MULTIBUILDER_MUSE_REASONING=low
MULTIBUILDER_MUSE_CONCURRENCY=4
MULTIBUILDER_MUSE_XDG_CONFIG_HOME=/srv/multibuilder/state/providers/muse/config
MULTIBUILDER_MUSE_XDG_DATA_HOME=/srv/multibuilder/state/providers/muse/data
MULTIBUILDER_GROK_ENABLED=false
MULTIBUILDER_OPENAI_ENABLED=false
