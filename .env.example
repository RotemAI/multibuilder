# Copy to .env and fill in before `docker compose up`.
# docker-compose.yml refuses to start without the first two.

# Dashboard login password. Without it, send/auto-respond endpoints accept
# keystrokes from anyone who can reach the port.
TMUX_DASH_PASS=change-me

# HMAC secret for auth cookies. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TMUX_DASH_SECRET=change-me

TMUX_DASH_USER=admin
TMUX_DASH_ROOT_PATH=/codex

# Host port and bind address. Defaults to loopback: put a TLS-terminating
# proxy in front before exposing this to a network.
TMUX_DASH_PORT=8501
TMUX_DASH_BIND=127.0.0.1

# AES-256 key for stored SSH credentials, base64 of 32 bytes. Generate one:
#   python3 -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Setting this keeps the key OUT of the state volume, so a copied volume alone
# cannot decrypt stored SSH passwords. Leave blank and the app generates a
# keyfile inside the volume instead — convenient, but weaker.
TMUX_DASH_SSH_KEY=

# Hosts to trust at startup, space-separated "host" or "host:port".
# Strict host-key checking stays enabled; this only pre-seeds known_hosts
# so the first connection is not rejected.
SSH_KNOWN_HOSTS=

# Optional
OPENAI_API_KEY=
PUBLIC_BASE_URL=

# Directory of SSH keys to mount read-only at /home/app/.ssh, for agent/key
# auth against real hosts. Leave as-is for none.
SSH_KEYS_DIR=./docker/ssh-empty

# ── Test-only (docker compose --profile testing) ────────────────────────────
TEST_SSH_USER=devuser
TEST_SSH_PASSWORD=devpass
TEST_SSH_PORT=2222
