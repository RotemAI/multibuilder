+function _currentTurnSeconds(name,st){
+  const live=st.live||{};
+  if(live.seen&&!live.done){
+    const parsed=_liveSeconds(st,true);
+    if(parsed!==null)return parsed;
+  }
+  const s=sessions.find(x=>x.name===name)||{};
+  const started=_metricNumber(s.current_turn_start);
+  return started===null?null:Math.max(0,Date.now()/1000-started);
+}
