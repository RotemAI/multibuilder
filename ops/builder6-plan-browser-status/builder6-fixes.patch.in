+class ReloginRequest(BaseModel):
+    expected_generation: str = Field(default="", max_length=32, strict=True)
+    expected_resume_uuid: str = Field(default="", max_length=36, strict=True)
+    completed_turn_id: str = Field(default="", max_length=36, strict=True)
+    expected_model: str = Field(default="", max_length=128, strict=True)
+    expected_effort: str = Field(default="", max_length=16, strict=True)
+
+
 @app.post("/api/sessions/{session_name}/relogin")
-async def api_session_relogin(session_name: str, request: Request):
+async def api_session_relogin(
+    session_name: str,
+    request: Request,
+    body: ReloginRequest | None = None,
+):
     """Restart Codex with the active CODEX_HOME and resume its latest thread."""
     user = _current_user(request)
     if not _user_can_access_session(user, session_name):
         return JSONResponse({"error": "Session not found"}, status_code=404)
+    owner_id = str(user.get("id") or "")
+    guarded = body is not None and any((
+        body.expected_generation,
+        body.expected_resume_uuid,
+        body.completed_turn_id,
+        body.expected_model,
+        body.expected_effort,
+    ))
+    restart_kwargs = {}
+    if guarded:
+        generation = body.expected_generation.strip()
+        resume_uuid = body.expected_resume_uuid.strip().lower()
+        completed_turn_id = body.completed_turn_id.strip().lower()
+        model = body.expected_model.strip()
+        effort = body.expected_effort.strip()
+        if (
+            not re.fullmatch(r"[0-9a-f]{32}", generation)
+            or _validated_codex_thread_id(resume_uuid) != resume_uuid
+            or _validated_codex_thread_id(completed_turn_id) != completed_turn_id
+            or (effort and effort not in _CODEX_REASONING_EFFORTS)
+        ):
+            return JSONResponse({"error": "Invalid relogin guard"}, status_code=400)
+        restart_kwargs.update({
+            "expected_owner_id": owner_id,
+            "expected_generation": generation,
+            "expected_resume_uuid": resume_uuid,
+            "completed_turn_id": completed_turn_id,
+            "expected_model": model,
+            "expected_effort": effort,
+        })
     running = await _async_is_codex_running(session_name)
-    _exported, restarted = await _restart_codex_for_session(session_name)
+    _exported, restarted = await _restart_codex_for_session(
+        session_name, **restart_kwargs
+    )
     return JSONResponse({
         "ok": restarted,
         "relaunched": restarted,
         "codex_was_running": running,
-    }, status_code=200 if restarted else 500)
+    }, status_code=200 if restarted else (409 if guarded else 500))
 
 
