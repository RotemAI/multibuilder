+"""Extract useful project details from human and assistant messages, without an LLM."""
+import re
+
+_URL = re.compile(r'https?://[^\s<>\[\]{}"\'`]+')
+_PATH = re.compile(r'(?:^|[\s(\[|>*`])((?:~/|/(?:home|root|tmp|var|opt|srv|mnt|data)/)[^\n<>\[\]{}"\'`|)]+)')
+_CREDENTIAL = re.compile(
+    r'^\s*(?:[-*+]\s+|\d+\.\s*)?(?:\*\*)?'
+    r'((?:(?:[\w.-]+)[ \t]+){0,3}(?:username|user name|user|password|passwd|login|email|api[ _-]?key|access[ _-]?token|secret))'
+    r'(?:\*\*)?\s*[:=]\s*(?:\*\*)?\s*(.+?)\s*$', re.I)
+_TABLE_CREDENTIAL = re.compile(
+    r'^\s*\|\s*(?:\*\*)?([^|]+?)(?:\*\*)?\s*\|\s*(.*?)\s*\|\s*$')
+
+
+def _value(text):
+    text = text.strip()
+    if len(text) >= 2 and text[0] == text[-1] and text[0] in '`"\'':
+        return text[1:-1]
+    return text
+
+
+def collect_saved_items(previous, texts, files=()):
+    """Accumulate exact values. Credentials are never comma/semicolon split."""
+    result = {key: list(previous.get(key) or []) for key in ('urls', 'creds', 'files')}
+    seen = {key: {repr(item) for item in values} for key, values in result.items()}
+
+    def add(key, item):
+        signature = repr(item)
+        if signature not in seen[key]:
+            result[key].append(item)
+            seen[key].add(signature)
+
+    for text in texts:
+        if not isinstance(text, str) or any(marker in text for marker in ("<environment_context>", "<INSTRUCTIONS>", "# AGENTS.md instructions", "<permissions instructions>")):
+            continue
+        for url in _URL.findall(text):
+            # Markdown's closing parenthesis and sentence punctuation are not part of a link.
+            url = url.rstrip('.,;:!*')
+            while url.endswith(')') and url.count(')') > url.count('('):
+                url = url[:-1]
+            add('urls', url)
+        for path in _PATH.findall(text):
+            path = re.sub(r':\d+(?::\d+)?$', '', path.strip().rstrip('.,;:*'))
+            # Unquoted prose after a path is not part of the file name.
+            if ' ' in path and not re.search(r'\.[\w-]+$', path):
+                path = path.split()[0]
+            add('files', path)
+        for line in text.splitlines():
+            table = _TABLE_CREDENTIAL.match(line)
+            if table:
+                line = table[1].strip('* ') + ': ' + table[2]
+            credential = _CREDENTIAL.match(line)
+            if credential:
+                value = _value(credential[2])
+                if value and value.lower() not in {'none', 'n/a', 'redacted', '[redacted]', '***'}:
+                    add('creds', {'label': credential[1].strip(), 'value': value})
+    for path in files:
+        if isinstance(path, str) and path:
+            add('files', path)
+    return result
