+def _collect_session_saved_items(session_name: str, user: dict, generation: str) -> dict:
+    """Incrementally read only this owner's validated root conversation."""
+    from project_saved import collect_saved_items
+
+    owner_id = str(user["id"])
+    key = hashlib.sha256(f"{session_name}\0{generation}".encode()).hexdigest()
+    store = LockedJsonStore(_user_data_dir(user) / "saved-projects" / f"{key}.json", dict)
+
+    def mutate(data):
+        texts = []
+        entry = cache.get(session_name) or {}
+        if str(entry.get("_owner_id") or "") == owner_id and _session_cache_entry_is_current(session_name, entry):
+            texts.extend(m.get("text", "") for m in entry.get("messages", []) if isinstance(m, dict) and m.get("role") in {"user", "assistant"})
+            texts.append(entry.get("notes", ""))
+        root = _session_lifecycle.get(session_name).get("resume_uuid")
+        if not root:
+            root = _active_session_root_thread_id(session_name, owner_id)
+        if root:
+            try:
+                fd, relative, fingerprint = _open_session_close_rollout({
+                    "owner": user, "owner_id": owner_id,
+                    "session_name": session_name, "resume_uuid": root,
+                })
+                with os.fdopen(fd, "rb") as stream:
+                    source = [relative, *fingerprint[:2]]
+                    offset = int(data.get("offset") or 0) if data.get("source") == source else 0
+                    if offset > fingerprint[2]:
+                        offset = 0
+                    if not offset:
+                        data.pop("discarding_line", None)
+                    stream.seek(offset)
+                    # Process bounded chunks, retaining a cursor for the next refresh.
+                    stop = offset + 4_000_000
+                    while stream.tell() < stop:
+                        start = stream.tell()
+                        line = stream.readline(4_000_001)
+                        if not line:
+                            break
+                        if not line.endswith(b"\n"):
+                            if len(line) > 4_000_000:
+                                data["discarding_line"] = True
+                                continue
+                            stream.seek(start)
+                            break
+                        if data.pop("discarding_line", False):
+                            continue
+                        try:
+                            event = json.loads(line)
+                        except (ValueError, UnicodeError):
+                            continue
+                        for event_type in ("user_message", "agent_message"):
+                            payload = _codex_event_payload(event, event_type)
+                            text = payload.get("message") if payload else None
+                            if isinstance(text, str) and not any(marker in text for marker in ("<environment_context>", "<INSTRUCTIONS>", "# AGENTS.md instructions", "<permissions instructions>")):
+                                texts.append(text)
+                    data.update(source=source, offset=stream.tell(), catching_up=stream.tell() < fingerprint[2])
+            except (_SessionCloseError, OSError, ValueError):
+                pass
+        uploads = _user_uploads_dir(user) / session_name
+        files = []
+        if uploads.is_dir() and not uploads.is_symlink():
+            files = [str(p) for p in uploads.iterdir() if p.is_file() and not p.is_symlink()]
+        data.update(collect_saved_items(data, texts, files))
+        data.update(session_name=session_name, generation=generation, owner_id=owner_id)
+        return {key: data.get(key, []) for key in ("urls", "creds", "files")} | {"catching_up": bool(data.get("catching_up"))}
+
+    _, result = store.update(mutate)
+    return result
+
