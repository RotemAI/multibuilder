+ sessions:[{name:'my project'}],selectedSession:'old',stopAllRawPolling:()=>{},_acknowledgeCompletion:()=>{},
+ navEl:{querySelectorAll:()=>[]},document:{getElementById:()=>null},renderDetail:()=>{}});
