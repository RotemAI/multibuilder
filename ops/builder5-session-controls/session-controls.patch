+@app.get("/api/sessions/{session_name}/saved-items")
+async def api_session_saved_items(request: Request, session_name: str):
+    user = _current_user(request)
+    if not user:
+        return JSONResponse({"error": "Not logged in"}, status_code=401)
+    owner_id = str(user["id"])
+    if not _is_valid_session_name(session_name) or not _strict_session_owner(session_name, owner_id):
+        return JSONResponse({"error": "Session not found"}, status_code=404)
+    generation = str(_session_lifecycle.get(session_name).get("generation") or "")
+    result = await asyncio.to_thread(_collect_session_saved_items, session_name, user, generation)
+    if not _strict_session_owner(session_name, owner_id) or str(_session_lifecycle.get(session_name).get("generation") or "") != generation:
+        return JSONResponse({"error": "Session changed"}, status_code=409)
+    return JSONResponse(result, headers={"Cache-Control": "no-store"})
+
